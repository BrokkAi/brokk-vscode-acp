{
  "name": "brokk-vscode-acp",
  "displayName": "Brokk ACP",
  "publisher": "brokk",
  "homepage": "https://brokk.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrokkAi/brokk-vscode-acp.git"
  },
  "bugs": {
    "url": "https://github.com/BrokkAi/brokk-vscode-acp/issues"
  },
  "author": "BrokkAi",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#181a1b",
    "theme": "dark"
  },
  "pricing": "Free",
  "description": "Open Agent Client Protocol coding in VS Code with bundled Anvil and the official ACP registry",
  "version": "0.4.0",
  "license": "GPL-3.0-only",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["acp", "agent", "coding", "brokk", "anvil"],
  "activationEvents": [
    "onStartupFinished",
    "onView:brokkAcp.chat",
    "onCommand:brokkAcp.connect",
    "onCommand:brokkAcp.refreshAgents"
  ],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "files": [
    "bin/**",
    "dist/**",
    "docs/screenshots/**",
    "icon.png",
    "legal/**",
    "licenses/**",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SOURCE.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    "source/**"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ACP agents can read, edit, and run commands in the workspace."
    }
  },
  "contributes": {
    "commands": [
      { "command": "brokkAcp.connect", "title": "Brokk ACP: Connect" },
      { "command": "brokkAcp.disconnect", "title": "Brokk ACP: Disconnect" },
      { "command": "brokkAcp.refreshAgents", "title": "Brokk ACP: Refresh Agent Registry" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "brokkAcp", "title": "Brokk ACP", "icon": "icon.png" }
      ]
    },
    "views": {
      "brokkAcp": [
        { "type": "webview", "id": "brokkAcp.chat", "name": "Chat" }
      ]
    },
    "configuration": {
      "title": "Brokk ACP",
      "properties": {
        "brokkAcp.defaultAgent": {
          "type": "string",
          "default": "bundled:anvil",
          "description": "Agent ID selected when a workspace first opens"
        },
        "brokkAcp.registry.url": {
          "type": "string",
          "default": "https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json",
          "description": "ACP registry index URL"
        },
        "brokkAcp.anvil.path": {
          "type": "string",
          "default": "",
          "description": "Override the bundled Anvil executable"
        },
        "brokkAcp.customAgents": {
          "type": "object",
          "default": {},
          "description": "Custom stdio ACP agents keyed by a stable ID",
          "additionalProperties": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name"
              },
              "command": {
                "type": "string",
                "description": "ACP agent executable"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "default": {}
              }
            }
          }
        },
        "brokkAcp.agent.command": {
          "type": "string",
          "default": "anvil",
          "description": "Legacy single custom ACP agent executable",
          "markdownDeprecationMessage": "Use `brokkAcp.customAgents` instead."
        },
        "brokkAcp.agent.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Legacy arguments passed to the single custom ACP agent",
          "markdownDeprecationMessage": "Use `brokkAcp.customAgents` instead."
        },
        "brokkAcp.host.path": {
          "type": "string",
          "default": "",
          "description": "Development override for the Rust host executable"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:rust && npm run compile:extension",
    "compile:rust": "cargo build --package brokk-acp-host",
    "compile:rust:release": "cargo build --release --package brokk-acp-host",
    "compile:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "check": "tsc --noEmit && cargo check --workspace",
    "test": "npm run check && npm run coverage && npm run test:markdown && npm run test:webview-layout && npm run test:plans && npm run test:lifecycle && npm run test:packaging-command && npm run release:check",
    "test:unit": "vitest run",
    "coverage": "npm run coverage:typescript && npm run coverage:rust",
    "coverage:typescript": "vitest run --coverage",
    "coverage:rust": "cargo llvm-cov --workspace --all-features --locked --lcov --output-path coverage-rust.lcov && node scripts/check-rust-coverage.mjs coverage-rust.lcov",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:plans": "node scripts/test-plans.mjs",
    "test:webview-layout": "node scripts/test-webview-layout.mjs",
    "test:lifecycle": "cargo build --package brokk-acp-host && node scripts/test-connection-lifecycle.mjs",
    "test:packaging-command": "node scripts/test-resolve-child-command.mjs",
    "license:generate": "node scripts/generate-host-third-party-notices.mjs",
    "license:check": "node scripts/generate-host-third-party-notices.mjs --check",
    "release:check": "node scripts/check-release.mjs",
    "package": "node scripts/package.mjs",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --watch",
    "vscode:prepublish": "npm run compile:extension"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "extract-zip": "^2.0.1",
    "happy-dom": "^20.11.1",
    "ovsx": "^1.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
